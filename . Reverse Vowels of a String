class Solution {
    public String reverseVowels(String s) {
        char[] arr = s.toCharArray();

        int first = 0;
        int last = arr.length - 1;

        while (first < last) {
            while (first < last && !isVowel(arr[first])) {
                first++;
            }

            while (first < last && !isVowel(arr[last])) {
                last--;
            }

            char temp = arr[first];
            arr[first] = arr[last];
            arr[last] = temp;

            first++;
            last--;
        }

        return new String(arr);
    }
    
    private boolean isVowel(char ch){
        ch=Character.toLowerCase(ch);
           return ch == 'a' || ch == 'e' || ch == 'i' ||
               ch == 'o' || ch == 'u';        
    }
}
