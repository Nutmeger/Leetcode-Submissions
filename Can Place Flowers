class Solution {
    public boolean canPlaceFlowers(int[] flowerbed, int n) {
        for(int i=0;i<flowerbed.length;i++){
            if(flowerbed[i]==0){
            int prev;
            
                if(i==0 || flowerbed[i-1]==0){
                prev=0;}
                else{
                prev=1;
                }
            int front;
            if(i==flowerbed.length-1 || flowerbed[i+1]==0)
           { front=0;}
           else{
            front=1;
           }
           if(n==0){
            break;
           }
            if(flowerbed[i]==0 && front==0 && prev==0){
                n-=1;
                flowerbed[i]=1;
            }

        }}
        if(n==0){
        return true;}
        else{
        return false;}
    }
}
